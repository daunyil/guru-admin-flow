{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "jsx": "react-jsx",
    "noEmit": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": false,
    "types": ["vite/client", "vitest/globals"],
    "baseUrl": "./src",
    "paths": {
      "@shared/*": ["shared/*"],
      "@modules/*": ["modules/*"],
      "@home/*": ["modules/home/*"],
      "@harian/*": ["modules/harian/*"],
      "@piket/*": ["modules/piket/*"],
      "@admin/*": ["modules/administrasi/*"],
      "@integrasi/*": ["modules/integrasi/*"],
      "@data/*": ["modules/data-dasar/*"]
    }
  },
  "include": ["src/**/*", "vite.config.ts", "tailwind.config.js", "postcss.config.js"],
  "exclude": ["src/**/__tests__/**", "src/**/__test__/**"]
}
